#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/mouse.h>

/*
 * Keyball39 Remap cheatsheet -> roBa/ZMK移植案
 * source: keymap_cheatsheet_keyball39.pdf
 *
 * 注意:
 * - roBaは42キー/トラックボール/ロータリーエンコーダ搭載のZMKキーボードです。
 * - Keyball39とは物理キー数・位置が違うため、roBa公式default keymapの並びに寄せて配置しています。
 * - ビルド時にエラーが出た場合、まず &lt_to_layer_0 の位置を通常の &lt / &mo に置き換えてください。
 */

&lt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&trackball {
    automouse-layer = <4>;
    scroll-layers = <5>;
};

/ {
    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;
            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &kp Q        &kp W        &kp E        &kp R        &kp T        &kp Y        &kp U        &kp I        &kp O        &kp P
                &mt LSHIFT A &kp S        &kp D        &kp F        &kp G        &kp LS(LG(S)) &kp MINUS    &kp H        &kp J        &kp K        &kp L        &mt LSHIFT TAB
                &mt LGUI Z   &kp X        &kp C        &kp V        &lt 2 B      &lt 2 N      &kp M        &kp COMMA    &kp DOT      &mt LGUI MINUS &lt 3 SLASH
                &kp GRAVE    &mt LALT GRAVE &kp LCTRL   &lt 1 INT_HENKAN &kp SPACE    &kp BSPC     &kp ENTER    &kp DEL
            >;
            sensor-bindings = <&inc_dec_kp PG_UP PAGE_DOWN>;
        };

        number_layer {
            bindings = <
                &kp EXCL     &kp AT       &kp HASH     &kp DLLR     &kp PRCNT    &kp CARET    &kp AMPS     &kp STAR     &kp LPAR     &kp RPAR
                &trans       &trans       &trans       &trans       &trans       &trans       &trans       &kp MINUS    &kp PLUS     &kp LBKT     &kp RBKT     &trans
                &trans       &trans       &trans       &trans       &trans       &kp SEMI     &kp BSLH     &kp COMMA    &kp DOT      &kp LBRC     &kp RBRC
                &trans       &trans       &trans       &trans       &trans       &kp BSPC     &kp ENTER    &kp PIPE
            >;
        };

        function_layer {
            bindings = <
                &kp F2       &kp F3       &kp F4       &kp F5       &kp F6       &kp F7       &kp F8       &kp F9       &kp F10      &kp F12
                &mt LSHIFT HOME &kp PG_DN  &kp UP       &kp PG_UP    &kp PSCRN    &kp PSCRN    &kp INS      &kp PSCRN    &kp INS      &kp UP       &kp DEL      &kp HOME
                &mt LGUI END &kp LEFT     &kp DOWN     &kp RIGHT    &trans       &trans       &kp LEFT     &kp DOWN     &kp RIGHT    &kp END      &kp ESC
                &mt LALT GRAVE &mt LCTRL INT_MUHENKAN &trans &trans &trans       &trans       &trans       &trans
            >;
        };

        utility_layer {
            bindings = <
                &trans       &trans       &trans       &trans       &trans       &trans       &trans       &trans       &trans       &trans
                &trans       &trans       &trans       &trans       &trans       &trans       &trans       &trans       &trans       &trans       &trans       &trans
                &trans       &trans       &trans       &trans       &kp UG_TOG   &kp UG_TOG   &trans       &trans       &trans       &trans       &trans
                &trans       &trans       &trans       &trans       &trans       &trans       &trans       &trans
            >;
        };

        mouse_layer {
            bindings = <
                &trans       &trans       &trans       &trans       &trans       &trans       &trans       &mkp MB2    &mkp MB4    &mkp MB5
                &trans       &trans       &mkp MB4    &mkp MB5    &trans       &trans       &trans       &trans       &mkp MB1    &trans       &trans       &trans
                &trans       &trans       &trans       &trans       &trans       &trans       &trans       &trans       &trans       &trans       &trans
                &trans       &trans       &trans       &mo 5       &mkp MB1    &trans       &mkp MB2
            >;
        };

        scroll_layer {
            bindings = <
                &trans       &trans       &trans       &trans       &trans       &trans       &trans       &mkp MB2    &mkp MB4    &mkp MB5
                &trans       &trans       &mkp MB4    &mkp MB5    &trans       &trans       &trans       &trans       &mkp MB1    &trans       &trans       &trans
                &trans       &trans       &trans       &trans       &trans       &trans       &trans       &trans       &trans       &trans       &trans
                &trans       &trans       &trans       &to 4      &mkp MB1    &trans       &mkp MB2
            >;
        };
    };
};
